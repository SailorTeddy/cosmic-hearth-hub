# Public Supabase keys (safe in the browser — RLS protects your data).
# Lovable: put these in the project `.env` file and republish.
# Local: copy to `.env` (and optionally `.env.local` for private keys).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Server functions (guestbook / claim-a-star). Same public values are fine.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here

# Private — use Vercel → Settings → Environment Variables, or local `.env.local` (gitignored)
# RESEND_API_KEY=re_xxxxxxxx
# GUESTBOOK_FROM_EMAIL=The Nichols Family <hello@emnichols.com>

# Daily horoscope email (Resend). Cron at 11:00 UTC ≈ 6am Eastern (7am during daylight time).
# Defaults to emmanuellovesall@gmail.com if HOROSCOPE_EMAIL_TO is unset.
# CRON_SECRET=long-random-string
# HOROSCOPE_EMAIL_TO=emmanuellovesall@gmail.com
# HOROSCOPE_FROM_EMAIL=The Nichols Family <hello@emnichols.com>
